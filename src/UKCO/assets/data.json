      "unitId": "unit_2",
      "language": "en",
      "title": "INTRODUCTION TO THE UK",
      "slug": "introduction-to-the-uk",
      "displayOrder": 2,
      "thumbnail": {
        "mediaId": "media_unit2_thumb",
        "url": "blob/UKCO/units/unit2/thumb.png",
        "altText": "Introduction to the UK"
      },
      "estimatedDuration": 20,
      "version": 1,
      "status": "draft",
      "isActive": false,
      "createdAt": "2026-02-25T10:00:00Z",
      "updatedAt": "2026-02-25T10:00:00Z",
      "publishedAt": null,
      "sections": [
        {
          "sectionId": "sec_1",
          "sectionType": "content",
          "displayOrder": 1,
          "title": "Location and Geography",
          "status": "draft",
          "sectionVersion": 1,
          "isMandatory": true,
          "content": [
            {
              "contentId": "sec1_c1",
              "order": 1,
              "type": "paragraph",
              "text": "The United Kingdom (UK) is made up of four countries: England, Scotland, Wales and Northern Ireland. The UK is an island nation located off the northwestern coast of Europe."
            },
            {
              "contentId": "sec1_c2",
              "order": 2,
              "type": "paragraph",
              "text": "The UK mainland is about 870 miles (1,400 km) from north to south. The population is approximately 67.6 million people."
            },
            {
              "contentId": "sec1_c3",
              "order": 3,
              "type": "list",
              "title": "Each country has its own capital city:",
              "items": [
                "England: London",
                "Scotland: Edinburgh",
                "Wales: Cardiff",
                "Northern Ireland: Belfast"
              ]
            },
            {
              "contentId": "sec1_c4",
              "order": 4,
              "type": "paragraph",
              "text": "Other major cities include Manchester, Birmingham, Liverpool, Leeds, Bristol, Glasgow, Aberdeen, Swansea and Newport."
            }
          ],
          "createdAt": "2026-02-25T10:00:00Z",
          "updatedAt": "2026-02-25T10:00:00Z"
        },
        {
          "sectionId": "sec_2",
          "sectionType": "content",
          "displayOrder": 2,
          "title": "Languages",
          "status": "draft",
          "sectionVersion": 1,
          "isMandatory": true,
          "content": [
            {
              "contentId": "sec2_c1",
              "order": 1,
              "type": "paragraph",
              "text": "English is the main language spoken in the UK. However, there are also regional languages:"
            },
            {
              "contentId": "sec2_c2",
              "order": 2,
              "type": "list",
              "items": [
                "Welsh is spoken in Wales",
                "Gaelic is spoken in parts of Scotland",
                "Irish Gaelic is spoken in parts of Northern Ireland"
              ]
            },
            {
              "contentId": "sec2_c3",
              "order": 3,
              "type": "paragraph",
              "text": "You will hear many different accents and dialects across the UK. Learning English is essential for settling into life in the UK."
            }
          ],
          "createdAt": "2026-02-25T10:00:00Z",
          "updatedAt": "2026-02-25T10:00:00Z"
        },
        {
          "sectionId": "sec_3",
          "sectionType": "content",
          "displayOrder": 3,
          "title": "Climate and Seasons",
          "status": "draft",
          "sectionVersion": 1,
          "isMandatory": true,
          "content": [
            {
              "contentId": "sec3_c1",
              "order": 1,
              "type": "paragraph",
              "text": "The UK has a temperate climate with rainfall throughout the year. Temperatures rarely drop below -11°C or rise above 35°C."
            },
            {
              "contentId": "sec3_c2",
              "order": 2,
              "type": "list",
              "title": "Seasons in the UK:",
              "items": [
                "Spring (March - May): Often rainy, with flowers and trees blooming.",
                "Summer (June - August): The warmest season with long sunny days and occasional thunderstorms.",
                "Autumn (September - November): Days get colder, leaves fall from trees, and it can be wet and windy.",
                "Winter (December - February): The coldest season with freezing temperatures, ice and sometimes snow."
              ]
            },
            {
              "contentId": "sec3_c3",
              "order": 3,
              "type": "paragraph",
              "text": "Clocks go forward one hour in March and back one hour in October for daylight savings."
            }
          ],
          "createdAt": "2026-02-25T10:00:00Z",
          "updatedAt": "2026-02-25T10:00:00Z"
        },
        {
          "sectionId": "sec_4",
          "sectionType": "content",
          "displayOrder": 4,
          "title": "Holidays and Celebrations",
          "status": "draft",
          "sectionVersion": 1,
          "isMandatory": true,
          "content": [
            {
              "contentId": "sec4_c1",
              "order": 1,
              "type": "paragraph",
              "text": "The UK has several public holidays (called Bank Holidays) when banks and many businesses are closed."
            },
            {
              "contentId": "sec4_c2",
              "order": 2,
              "type": "list",
              "items": [
                "New Year’s Day (1 January)",
                "Early May Bank Holiday",
                "Late May/Early June Bank Holiday",
                "August Bank Holiday",
                "Christmas Day (25 December)",
                "Boxing Day (26 December)"
              ]
            }
          ],
          "createdAt": "2026-02-25T10:00:00Z",
          "updatedAt": "2026-02-25T10:00:00Z"
        },
        {
          "sectionId": "sec_5",
          "sectionType": "content",
          "displayOrder": 5,
          "title": "Government and Politics",
          "status": "draft",
          "sectionVersion": 1,
          "isMandatory": true,
          "content": [
            {
              "contentId": "sec5_c1",
              "order": 1,
              "type": "paragraph",
              "text": "The UK is a constitutional monarchy and a parliamentary democracy."
            },
            {
              "contentId": "sec5_c2",
              "order": 2,
              "type": "paragraph",
              "text": "Head of State: King Charles III. Prime Minister: Sir Keir Starmer."
            },
            {
              "contentId": "sec5_c3",
              "order": 3,
              "type": "paragraph",
              "text": "Parliament has three parts: the King, the House of Lords and the House of Commons."
            }
          ],
          "createdAt": "2026-02-25T10:00:00Z",
          "updatedAt": "2026-02-25T10:00:00Z"
        },
        {
          "sectionId": "sec_6",
          "sectionType": "content",
          "displayOrder": 6,
          "title": "People and Culture",
          "status": "draft",
          "sectionVersion": 1,
          "isMandatory": true,
          "content": [
            {
              "contentId": "sec6_c1",
              "order": 1,
              "type": "list",
              "title": "British values include:",
              "items": ["Tolerance", "Fairness", "Respect"]
            }
          ],
          "createdAt": "2026-02-25T10:00:00Z",
          "updatedAt": "2026-02-25T10:00:00Z"
        },
        {
          "sectionId": "sec_7",
          "sectionType": "content",
          "displayOrder": 7,
          "title": "Religion",
          "status": "draft",
          "sectionVersion": 1,
          "isMandatory": true,
          "content": [
            {
              "contentId": "sec7_c1",
              "order": 1,
              "type": "paragraph",
              "text": "The official religion is Christianity, but the UK is a multi-faith society. You are free to practise your religion."
            }
          ],
          "createdAt": "2026-02-25T10:00:00Z",
          "updatedAt": "2026-02-25T10:00:00Z"
        },
        {
          "sectionId": "sec_8",
          "sectionType": "content",
          "displayOrder": 8,
          "title": "Social Etiquette",
          "status": "draft",
          "sectionVersion": 1,
          "isMandatory": true,
          "content": [
            {
              "contentId": "sec8_c1",
              "order": 1,
              "type": "list",
              "title": "Do:",
              "items": [
                "Queue and wait your turn",
                "Say please, thank you and sorry",
                "Be on time",
                "Offer your seat to pregnant women, elderly or disabled people"
              ]
            }
          ],
          "createdAt": "2026-02-25T10:00:00Z",
          "updatedAt": "2026-02-25T10:00:00Z"
        },
        {
          "sectionId": "sec_9",
          "sectionType": "content",
          "displayOrder": 9,
          "title": "UK Money",
          "status": "draft",
          "sectionVersion": 1,
          "isMandatory": true,
          "content": [
            {
              "contentId": "sec9_c1",
              "order": 1,
              "type": "paragraph",
              "text": "The official currency is the British Pound (£), also called Pound Sterling. One pound equals 100 pence."
            }
          ],
          "createdAt": "2026-02-25T10:00:00Z",
          "updatedAt": "2026-02-25T10:00:00Z"
        },
